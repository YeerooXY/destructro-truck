{
  "schema_version": "0.2.0",
  "project_id": "destructro-truck",
  "name": "Destructro Truck",
  "status": "task_split_review",
  "default_view": "overview",
  "repository": {
    "provider": "github",
    "full_name": "YeerooXY/destructro-truck",
    "default_branch": "main",
    "initialized": true,
    "visibility": "public",
    "web_url": "https://github.com/YeerooXY/destructro-truck",
    "implementation_root": "."
  },
  "workflow": {
    "mode": "repository_first",
    "state_source": "merged_artifacts_and_pull_requests",
    "change_boundary": "pull_request",
    "requirements_pr": "separate",
    "planning_pr": "separate",
    "task_split_pr": "separate"
  },
  "paths": {
    "intake": {
      "dir": "assembly/intake",
      "intake_session": "assembly/intake/intake_session.json",
      "project_intake": "assembly/intake/project_intake.json"
    },
    "requirements": {
      "dir": "assembly/requirements",
      "requirements_doc": "assembly/requirements/REQUIREMENTS.md"
    },
    "planning_runs": "assembly/planning_runs",
    "task_split_runs": "assembly/task_split_runs",
    "task_backlog": "assembly/generated/task_backlog.json",
    "task_batch_index": "assembly/generated/task_batch_index.json",
    "generated": "assembly/generated",
    "context": "assembly/context",
    "prompts": "assembly/prompts",
    "contracts": "assembly/contracts",
    "viewer": "assembly/web",
    "tools": "assembly/tools"
  },
  "ai_guidance": {
    "onboarding_mode": "guided_pr",
    "human_next_step": "Review and merge the Task Splitter pull request. After merge, begin development from dependency-ready tasks in the canonical backlog.",
    "notes": [
      "Chat context is temporary; merged repository files are authoritative.",
      "The canonical backlog contains 114 tasks across eight agent roles.",
      "The dependency graph has zero missing references and zero circular dependencies.",
      "Task prefixes identify owning agents, not global execution order.",
      "Normal useful concurrency is 2-5 agents; use 4-6 only when dependencies are ready and file ownership is disjoint.",
      "Do not start implementation until the Task Splitter pull request is merged."
    ]
  }
}
